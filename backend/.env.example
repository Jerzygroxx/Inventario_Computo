# Variables de entorno para el backend
# Copia este archivo como .env y ajusta los valores
# En Railway: MySQL Plugin provee MYSQL_HOST, MYSQL_PORT, etc.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=inventario_computo

# Railway MySQL Plugin (alternativa a DB_*)
# MYSQL_HOST=
# MYSQL_PORT=
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DATABASE=

JWT_SECRET=inventario_secret_key_2024

PORT=4000
